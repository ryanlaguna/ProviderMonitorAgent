# Must point to the providers directory, not the consuming project's root.
LOCAL_REPO_PATH=/absolute/path/to/project/providers
# Must live outside LOCAL_REPO_PATH. Relative paths resolve against working directory.
STATE_DIR=.pma
POLL_INTERVAL_SECONDS=300
UI_PORT=8787
MAX_COMMITS_PER_SCAN=50
GIT_TIMEOUT_SECONDS=180
LLM_TIMEOUT_SECONDS=60

# Optional OpenAI-compatible chat completions endpoint. Both must be set for AI.
# Without these, the application performs conservative preliminary triage only.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# Describe build flags, platforms, APIs used, constraints, and provider integration.
LOCAL_USAGE_CONTEXT=

# For vendored/copied code, create an explicit baseline JSON file (see README).
# BASELINES_FILE=.pma/baselines.json
# Optional: override upstream repository or branch (default branch is discovered).
# LLAMA_REMOTE=https://github.com/ggml-org/llama.cpp.git
# LLAMA_BRANCH=master
# OPENVINO_REMOTE=https://github.com/openvinotoolkit/openvino.genai.git
# OPENVINO_BRANCH=master
# ONNX_REMOTE=https://github.com/microsoft/onnxruntime-genai.git
# ONNX_BRANCH=main
